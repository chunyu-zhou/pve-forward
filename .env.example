# Docker Compose only pulls the image; all builds run in GitHub Actions.
IMAGE_TAG=latest

# Host binding and port; the container always listens on 5000.
BIND_ADDRESS=0.0.0.0
PORT=5000

# External origin reachable by browsers AND PVE agents. Include a nonstandard port.
# Replace this example with your real IP/domain before the first start.
PUBLIC_URL=https://panel.example.com:5000
TLS_MODE=self
SITE_NAME='PVE Forward'

# Used only for the first initialization of an empty data volume.
# Existing users/passwords are never reset by restart/recreation.
ADMIN_USER=admin
# Required: set your own unique password (8-72 UTF-8 bytes).
# Single quotes prevent Compose from expanding a $ inside the password.
ADMIN_PASSWORD=''
