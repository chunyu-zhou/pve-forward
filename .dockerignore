# Deny by default: only production build inputs enter the Docker context.
**
!Dockerfile
!.dockerignore
!go.mod
!go.sum
!version.json
!version.go
!cmd/
!cmd/**/
!cmd/**/*.go
!internal/
!internal/**/
!internal/**/*.go
!web/
!web/embed.go
!web/package.json
!web/package-lock.json
!web/index.html
!web/vite.config.js
!web/src/
!web/src/**/
!web/src/**/*.vue
!web/src/**/*.js
!web/src/**/*.css

# Defense in depth, even when these occur inside an allowed source directory.
**/.git/**
**/node_modules/**
**/dist/**
**/data/**
**/backups/**
**/secrets/**
**/secret/**
# internal/secret is production Go source, not runtime secret material.
!internal/secret/
!internal/secret/*.go
**/.env
**/.env.*
**/*.db
**/*.db-wal
**/*.db-shm
**/*.sqlite*
**/master.key
**/setup-token
**/agent.json
**/*.key
**/*.pem
**/*.p12
**/*.pfx
**/credentials*
**/*_test.go
